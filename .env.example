# SlateGate Configuration Template
# Copy this file to .env and configure your environment

# App Configuration
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
DEFAULT_DATA_MODE=auto

# Google Gemini / Vertex AI Configuration
# Set either GEMINI_API_KEY for Google AI Studio or configure Vertex AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ClickHouse Cloud / Cluster Connection
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=slategate
CLICKHOUSE_SECURE=true

# ClickHouse MCP Server Configuration
CLICKHOUSE_MCP_COMMAND=uvx
CLICKHOUSE_MCP_PACKAGE=mcp-clickhouse
CLICKHOUSE_MCP_TIMEOUT_SECONDS=10
